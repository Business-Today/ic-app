{
  "expo": {
    "name": "BT IC",
    "slug": "ic-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/ic-logo-app.png",
    "scheme": "icapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "2",
      "supportsTablet": false,
      "bundleIdentifier": "org.businesstoday.ic",
      "infoPlist": {
        "NSCameraUsageDescription": "BT Conference uses your camera to scan QR codes for conference check-in and to take a profile photo for your attendee profile.",
        "ITSAppUsesNonExemptEncryption": false,
        "NFCReaderUsageDescription": "BT Conference uses NFC to tap attendee tags for conference check-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/app-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "org.businesstoday.ic"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "BT Conference uses your camera to scan QR codes for conference check-in and to take a profile photo for your attendee profile."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "BT Conference uses NFC to tap attendee tags for conference check-in.",
          "includeNdefEntitlement": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ada5ea8a-a622-4eb9-8bcb-4a468846cb9c"
      }
    }
  }
}
